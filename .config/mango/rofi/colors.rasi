/* Generated from wallpaper: a_cartoon_of_a_man_riding_a_horse_in_a_forest.jpg */

* {
    bg:          #201f25;
    fg:          #d2cbbc;
    accent:      #5eb8c2;
    accent-2:    #8387b4;
    border:      #5eb8c2;
    urgent:      #cb8a86;
    selected-fg: #d2cbbc;
    entry-fg:    #8387b4;
    prompt-fg:   #5eb8c2;
    header:      #8387b4;

    background-color: @bg;
}
